# Primary Provider Toggle: "openai" | "anthropic" | "gemini"
RESEARCH_LLM_PROVIDER=openai

# Model Selection
DEFAULT_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini

# Provider Keys (only supply the one you intend to use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SEC EDGAR Identity (Required by SEC: "Name AdminEmail@domain.com")
SEC_USER_AGENT="ResearchBot user@example.com"

# Local Storage Paths
SQLITE_DB_PATH="data/state.db"
CHROMA_PERSIST_DIR="data/vector_store"

# Langfuse Observability (Optional for development)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"